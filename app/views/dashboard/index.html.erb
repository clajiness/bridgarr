<% content_for :title, "Dashboard" %>
<%= turbo_stream_from "dashboard" %>

<div class="space-y-6">
  <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-3xl font-semibold text-slate-950">Dashboard</h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">Your indexers, apps, and assignments—all tied together.</p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Preview changes", preview_indexer_apps_path, class: "inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-stone-50" %>
      <%= link_to "Discover indexers", discover_indexers_path, class: "inline-flex items-center justify-center rounded-md bg-amber-500 px-4 py-2.5 text-sm font-semibold text-stone-950 shadow-sm hover:bg-amber-400" %>
    </div>
  </section>

  <section class="flex flex-col gap-3 rounded-md border px-5 py-4 shadow-sm sm:flex-row sm:items-center sm:justify-between <%= dashboard_operational_classes(@dashboard) %>">
    <div>
      <h2 class="font-semibold text-slate-950"><%= dashboard_operational_title(@dashboard) %></h2>
      <p class="mt-1 text-sm leading-6 text-slate-600"><%= dashboard_operational_summary(@dashboard) %></p>
    </div>
    <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold">
      <% unless @dashboard.readiness.complete? %><%= link_to "Setup", readiness_path, class: "text-slate-700 hover:text-slate-950" %><% end %>
      <% if @dashboard.external_services_health.attention_count.positive? || @dashboard.health_checks_pending? || @dashboard.health_cycle_attention? %><%= link_to "Health", health_path, class: "text-slate-700 hover:text-slate-950" %><% end %>
      <% if @dashboard.latest_sync_run_needs_attention? || @dashboard.latest_sync_run_active? %><%= link_to "Sync run", sync_run_path(@dashboard.latest_sync_run), class: "text-slate-700 hover:text-slate-950" %><% end %>
      <% if @dashboard.jackett_changes_count.positive? %><%= link_to "Jackett changes", indexers_path, class: "text-slate-700 hover:text-slate-950" %><% end %>
      <% if @dashboard.proxy_failures_count.positive? %><%= link_to "Proxy failures", proxy_activity_path(status: "failed"), class: "text-slate-700 hover:text-slate-950" %><% end %>
    </div>
  </section>

  <section class="overflow-hidden rounded-md border border-stone-200 bg-white shadow-sm">
    <div class="flex flex-col gap-4 border-b border-slate-200 px-4 py-4 lg:flex-row lg:items-center lg:justify-between">
      <nav class="flex flex-wrap gap-2" aria-label="Assignment views">
        <% Dashboard::Overview::FILTERS.each do |filter| %>
          <%= link_to root_path(filter:, query: @dashboard.query.presence, per_page: @assignment_rows_page.per_page), class: class_names(
            "rounded-md border px-3 py-2 text-sm font-semibold",
            @dashboard.selected_filter == filter ? "border-slate-900 bg-slate-900 text-white" : "border-stone-300 bg-white text-slate-700 hover:bg-stone-50"
          ) do %>
            <%= dashboard_assignment_filter_label(filter) %>
            <span class="ml-1 opacity-70"><%= @dashboard.assignment_filter_counts.fetch(filter) %></span>
          <% end %>
        <% end %>
      </nav>

      <%= form_with url: root_path, method: :get, class: "flex w-full gap-2 lg:max-w-sm" do |form| %>
        <%= form.hidden_field :filter, value: @dashboard.selected_filter %>
        <%= form.hidden_field :per_page, value: @assignment_rows_page.per_page %>
        <%= form.search_field :query, value: @dashboard.query, placeholder: "Search indexer or app", aria: { label: "Search assignments" }, class: "min-w-0 flex-1 rounded-md border border-stone-300 px-3 py-2 text-sm" %>
        <%= form.submit "Search", class: "rounded-md border border-stone-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-stone-50" %>
      <% end %>
    </div>

    <% if @assignment_rows.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-stone-100 text-left text-xs font-semibold uppercase tracking-normal text-slate-600">
            <tr>
              <th class="px-4 py-3">Indexer</th>
              <th class="px-4 py-3">Destination</th>
              <th class="px-4 py-3">Desired state</th>
              <th class="px-4 py-3">Assignment state</th>
              <th class="px-4 py-3">Indexer health</th>
              <th class="px-4 py-3">Last applied</th>
              <th class="px-4 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% @assignment_rows.each do |row| %>
              <% assignment = row.assignment %>
              <% indexer_health_status = record_health_status(row.indexer, now: @dashboard.now) %>
              <tr class="align-top hover:bg-stone-50/70">
                <td class="px-4 py-4">
                  <%= link_to row.indexer.name, row.indexer, class: "font-semibold text-slate-950 hover:underline" %>
                  <span class="mt-1 block font-mono text-xs text-slate-500"><%= row.indexer.jackett_id %></span>
                </td>
                <td class="px-4 py-4">
                  <%= link_to row.arr_app.name, row.arr_app, class: "font-semibold text-slate-950 hover:underline" %>
                  <span class="mt-1 block text-xs text-slate-500"><%= row.arr_app.app_type.titleize %></span>
                </td>
                <td class="px-4 py-4">
                  <div class="flex flex-wrap gap-1">
                    <% assignment_search_mode_badges(assignment).each do |label, enabled| %>
                      <span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= enabled_status_classes(enabled) %>"><%= label %></span>
                    <% end %>
                  </div>
                  <p class="mt-2 text-xs text-slate-500"><%= assignment.connection_mode.titleize %> · <%= assignment.category_mode.titleize %> categories</p>
                </td>
                <td class="max-w-xs px-4 py-4">
                  <span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= dashboard_assignment_status_classes(row.status) %>"><%= dashboard_assignment_status_label(row.status) %></span>
                  <p class="mt-2 text-xs leading-5 text-slate-600"><%= row.detail %></p>
                </td>
                <td class="max-w-xs px-4 py-4">
                  <%= link_to health_path, class: "inline-flex rounded-md border px-2 py-1 text-xs font-semibold #{health_status_classes(indexer_health_status)}" do %>
                    <%= health_status_label(indexer_health_status, operational: true) %>
                  <% end %>
                  <p class="mt-2 text-xs leading-5 text-slate-600"><%= dashboard_indexer_health_detail(indexer_health_status) %></p>
                  <% if row.indexer.last_tested_at.present? %>
                    <p class="mt-1 whitespace-nowrap text-xs text-slate-500">Checked <%= format_server_timestamp(row.indexer.last_tested_at) %></p>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-4 py-4 text-slate-700"><%= row.last_applied_at ? format_server_timestamp(row.last_applied_at) : "Never" %></td>
                <td class="px-4 py-4 text-right">
                  <div class="flex flex-wrap justify-end gap-x-3 gap-y-2 text-xs font-semibold">
                    <%= link_to "Preview", preview_indexer_apps_path(assignment_ids: [ assignment.id ]), class: "text-blue-700 hover:text-blue-900" %>
                    <% if !row.indexer.enabled? || !row.arr_app.enabled? %>
                      <span class="text-slate-500">Sync paused</span>
                    <% elsif Jackett::IndexerAvailability.call(indexer: row.indexer).available? %>
                      <%= button_to "Sync", sync_indexer_app_path(assignment), method: :post, class: "cursor-pointer text-slate-700 hover:text-slate-950", form: { class: "inline" } %>
                    <% else %>
                      <%= link_to "Review source", row.indexer, class: row.status == "source_unverified" ? "text-amber-800 hover:text-amber-950" : "text-red-700 hover:text-red-900" %>
                    <% end %>
                    <%= link_to "Settings", edit_indexer_app_path(assignment, return_to: "dashboard"), class: "text-slate-700 hover:text-slate-950" %>
                    <% if row.attention? || assignment.last_error.present? %><%= render "indexer_apps/diagnostic_button", assignment: %><% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination",
        pagination: @assignment_rows_page,
        item_name: "assignment",
        path: root_path,
        preserved_params: { filter: @dashboard.selected_filter, query: @dashboard.query.presence } %>
    <% else %>
      <div class="px-6 py-12 text-center">
        <% if @dashboard.assignments_count.zero? %>
          <p class="text-sm font-medium text-slate-700">Nothing is tied together yet.</p>
          <p class="mt-2 text-sm text-slate-500"><%= link_to "Open the assignment matrix", indexer_apps_path, class: "font-semibold text-slate-700 underline" %> to connect an indexer to an application.</p>
        <% else %>
          <p class="text-sm font-medium text-slate-700">No assignments match this view.</p>
          <%= link_to "Clear filters", root_path(per_page: @assignment_rows_page.per_page), class: "mt-2 inline-block text-sm font-semibold text-slate-700 underline" %>
        <% end %>
      </div>
    <% end %>
  </section>
</div>
