<div class="mt-2 text-xs leading-5 text-slate-700">
  <p><%= sync_category_mismatch_explanation(sync_run_item) %></p>

  <% if sync_run_item.indexer_app.present? %>
    <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-semibold">
      <% if !sync_run_item.indexer_app.indexer.enabled? || !sync_run_item.indexer_app.arr_app.enabled? %>
        <span class="text-slate-500">Sync paused</span>
      <% elsif (source_availability = Jackett::IndexerAvailability.call(indexer: sync_run_item.indexer_app.indexer)).available? %>
        <%= button_to "Retry assignment",
          sync_indexer_app_path(sync_run_item.indexer_app),
          class: "text-blue-700 hover:text-blue-900",
          form_class: "inline",
          data: { turbo_confirm: "Retry this assignment using its current settings?" } %>
      <% else %>
        <%= link_to "Review source",
          sync_run_item.indexer_app.indexer,
          class: source_availability.state == "unverified" ? "text-amber-800 hover:text-amber-950" : "text-red-700 hover:text-red-900" %>
      <% end %>
      <%= link_to "Review categories",
        edit_indexer_app_path(sync_run_item.indexer_app),
        class: "text-blue-700 hover:text-blue-900" %>
    </div>
  <% end %>

  <% if sync_category_evidence?(sync_run_item) %>
    <details class="mt-2">
      <summary class="cursor-pointer font-semibold text-slate-600 hover:text-slate-950">Show category details</summary>
      <dl class="mt-2 grid gap-x-4 gap-y-1 sm:grid-cols-[auto_1fr]">
        <dt class="font-semibold text-slate-600">Mode</dt>
        <dd><%= sync_category_mode(sync_run_item) %></dd>
        <dt class="font-semibold text-slate-600">Sent to app</dt>
        <dd class="font-mono"><%= sync_category_ids_sent(sync_run_item) %></dd>
        <dt class="font-semibold text-slate-600">Jackett check</dt>
        <dd><%= sync_category_support(sync_run_item) %></dd>
        <dt class="font-semibold text-slate-600">Selection</dt>
        <dd><%= sync_category_selection_basis(sync_run_item) %></dd>
      </dl>
    </details>
  <% end %>
</div>
