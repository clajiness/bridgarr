<% content_for :title, "Reconciliation preview" %>

<div class="space-y-6">
  <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-mono text-sm text-slate-500">inspection only</p>
      <h1 class="mt-1 text-3xl font-semibold text-slate-950">Reconciliation preview</h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Generated <%= format_server_timestamp(@plan.generated_at) %>. No remote configuration was changed.</p>
    </div>
    <%= link_to "Assignment matrix", indexer_apps_path, class: "inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-stone-50" %>
  </section>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% Sync::Plan::STATES.each do |state| %>
      <% count = @plan.counts.fetch(state, 0) %>
      <% next if count.zero? %>
      <div class="rounded-md border border-stone-200 bg-white px-4 py-3 shadow-sm">
        <span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= reconciliation_state_classes(state) %>"><%= reconciliation_state_label(state) %></span>
        <p class="mt-2 text-2xl font-semibold text-slate-950"><%= count %></p>
      </div>
    <% end %>
  </div>

  <% if @plan.destructive_items.any? %>
    <section class="rounded-md border border-red-300 bg-red-50 px-5 py-4 shadow-sm">
      <div class="flex items-start gap-4">
        <p class="text-3xl font-semibold text-red-950"><%= @plan.destructive_items.size %></p>
        <div>
          <h2 class="font-semibold text-red-950"><%= "assignment".pluralize(@plan.destructive_items.size).capitalize %> will have remote search modes disabled</h2>
          <p class="mt-1 text-sm leading-6 text-red-900">Applying these changes will disable remote RSS, automatic search, and interactive search. Review each affected assignment below.</p>
        </div>
      </div>
    </section>
  <% end %>

  <%= form_with url: apply_plan_indexer_apps_path, class: "space-y-4" do |form| %>
    <div class="overflow-hidden rounded-md border border-stone-200 bg-white shadow-sm">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-stone-100 text-left text-xs font-semibold uppercase tracking-normal text-slate-600">
          <tr>
            <th class="px-4 py-3">Apply</th>
            <th class="px-4 py-3">Assignment</th>
            <th class="px-4 py-3">Plan</th>
            <th class="px-4 py-3">Changes and next action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% @plan.items.each do |item| %>
            <% assignment = item.indexer_app %>
            <tr class="align-top">
              <td class="px-4 py-4">
                <% if item.applyable? %>
                  <%= check_box_tag "assignment_ids[]", assignment.id, true, class: "h-4 w-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500" %>
                  <%= hidden_field_tag "expected_digests[#{assignment.id}]", item.plan_digest %>
                <% else %>
                  <span class="text-slate-400" aria-label="No apply action">—</span>
                <% end %>
              </td>
              <td class="px-4 py-4">
                <p class="font-medium text-slate-950"><%= assignment.indexer.name %></p>
                <p class="mt-1 text-xs text-slate-500"><%= assignment.arr_app.name %> · <%= assignment.connection_mode.titleize %> · <%= assignment.enabled? ? "Enabled" : "Disabled" %></p>
              </td>
              <td class="px-4 py-4"><span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= reconciliation_state_classes(item.state) %>"><%= reconciliation_state_label(item.state) %></span></td>
              <td class="px-4 py-4">
                <p class="text-sm leading-6 text-slate-700"><%= item.message %></p>
                <% if item.destructive %>
                  <p class="mt-2 text-xs font-semibold text-red-800">Remote search modes will be disabled.</p>
                <% end %>
                <% if item.changes.any? %>
                  <ul class="mt-2 space-y-1 text-xs leading-5 text-slate-600">
                    <% item.changes.each do |change| %>
                      <li><span class="font-semibold text-slate-800"><%= change["label"] %>:</span> <%= change["current"] %> → <%= change["desired"] %></li>
                    <% end %>
                  </ul>
                <% end %>
                <div class="mt-3 flex flex-wrap gap-3 text-xs font-semibold">
                  <%= link_to "Assignment settings", edit_indexer_app_path(assignment, return_to: "preview"), class: "text-slate-700 hover:text-slate-950" %>
                  <% if item.state == "conflict" && item.remote_indexer_id.present? %>
                    <% repair_confirmation = if assignment.enabled?; "Associate this assignment with remote indexer ID #{item.remote_indexer_id} and sync it?"; else; "Associate this assignment with remote indexer ID #{item.remote_indexer_id}? You will return to preview before any remote change."; end %>
                    <%= link_to "Repair association", repair_indexer_app_path(assignment, remote_indexer_id: item.remote_indexer_id), class: "text-blue-700 hover:text-blue-900", data: { turbo_method: :post, turbo_confirm: repair_confirmation } %>
                  <% elsif item.state == "orphaned" %>
                    <%= link_to "Forget stale association", forget_remote_indexer_app_path(assignment), class: "text-blue-700 hover:text-blue-900", data: { turbo_method: :post, turbo_confirm: "Forget remote indexer ID #{assignment.remote_indexer_id}? This does not delete anything remotely." } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @plan.applyable_items.any? %>
      <div class="space-y-4">
        <% if @plan.destructive_items.any? %>
          <label class="flex items-start gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-950">
            <%= check_box_tag :confirm_destructive, "1", false, class: "mt-1 h-4 w-4 rounded border-red-300 text-red-700 focus:ring-red-600" %>
            <span><strong class="block">Confirm remote search-mode disablement</strong><span class="mt-1 block text-xs leading-5">I reviewed the affected assignments and understand that applying the selected destructive changes will disable remote search modes.</span></span>
          </label>
        <% end %>
        <div class="flex justify-end">
          <%= form.submit "Apply selected plan", class: "rounded-md bg-amber-500 px-4 py-2.5 text-sm font-semibold text-stone-950 shadow-sm hover:bg-amber-400" %>
        </div>
      </div>
    <% else %>
      <p class="text-right text-sm text-slate-600">Nothing to apply.</p>
    <% end %>
  <% end %>
</div>
