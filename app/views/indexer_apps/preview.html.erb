<% content_for :title, "Reconciliation preview" %>
<% revert_options_by_assignment_id = @plan.items.to_h { |item| [ item.indexer_app.id, Sync::DesiredStateReverter.options_for(item) ] } %>
<% revertible_assignment_ids = revert_options_by_assignment_id.filter_map { |assignment_id, options| assignment_id if options.any? } %>
<% unchanged_items, reviewed_items = @plan.items.partition { |item| item.state == "unchanged" } %>

<div class="space-y-6">
  <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-semibold text-slate-950">Reconciliation preview</h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">Generated <%= format_server_timestamp(@plan.generated_at) %>. No remote configuration was changed.</p>
    </div>
    <%= link_to "Assignment matrix", indexer_apps_path, class: "inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-stone-50" %>
  </section>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% Sync::Plan::STATES.each do |state| %>
      <% count = @plan.counts.fetch(state, 0) %>
      <% next if count.zero? %>
      <div class="rounded-md border border-stone-200 bg-white px-4 py-3 shadow-sm">
        <span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= reconciliation_state_classes(state) %>"><%= reconciliation_state_label(state) %></span>
        <p class="mt-2 text-2xl font-semibold text-slate-950"><%= count %></p>
      </div>
    <% end %>
  </div>

  <% if @plan.destructive_items.any? %>
    <section class="rounded-md border border-red-300 bg-red-50 px-5 py-4 shadow-sm">
      <div class="flex items-start gap-4">
        <p class="text-3xl font-semibold text-red-950"><%= @plan.destructive_items.size %></p>
        <div>
          <h2 class="font-semibold text-red-950"><%= "assignment".pluralize(@plan.destructive_items.size).capitalize %> will have remote search modes disabled</h2>
          <p class="mt-1 text-sm leading-6 text-red-900">Applying these changes will disable one or more remote search modes. Review each affected assignment below.</p>
        </div>
      </div>
    </section>
  <% end %>

  <%= form_with url: apply_plan_indexer_apps_path, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :preview_scope, params.key?(:assignment_ids) ? "selected" : "all" %>
    <% if params.key?(:assignment_ids) %>
      <% @plan.items.each do |item| %><%= hidden_field_tag "preview_assignment_ids[]", item.indexer_app.id %><% end %>
    <% end %>
    <% revertible_assignment_ids.each do |assignment_id| %><%= hidden_field_tag "revert_assignment_ids[]", assignment_id %><% end %>

    <% if reviewed_items.any? %>
      <div class="overflow-hidden rounded-md border border-stone-200 bg-white shadow-sm">
        <%= render "preview_items_table",
          items: reviewed_items,
          revert_options_by_assignment_id:,
          table_kind: "review" %>
      </div>
    <% elsif unchanged_items.any? %>
      <div class="rounded-md border border-green-200 bg-green-50 px-5 py-4 text-sm text-green-900 shadow-sm">
        <p class="font-semibold"><%= unchanged_items.one? ? "This assignment already matches." : "All #{unchanged_items.size} assignments already match." %></p>
        <p class="mt-1 text-green-800">Nothing needs to be applied.</p>
      </div>
    <% else %>
      <div class="rounded-md border border-stone-200 bg-white px-5 py-4 text-sm text-slate-600 shadow-sm">No assignments were available to inspect.</div>
    <% end %>

    <% if unchanged_items.any? %>
      <details class="group rounded-md border border-stone-200 bg-white shadow-sm" data-no-change-assignments>
        <summary class="cursor-pointer list-none px-5 py-4 text-sm font-semibold text-slate-700 hover:text-slate-950 [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">Show <%= pluralize(unchanged_items.size, "no-change assignment") %></span>
          <span class="hidden group-open:inline">Hide <%= pluralize(unchanged_items.size, "no-change assignment") %></span>
        </summary>
        <div class="border-t border-slate-200">
          <%= render "preview_items_table",
            items: unchanged_items,
            revert_options_by_assignment_id:,
            table_kind: "no-change" %>
        </div>
      </details>
    <% end %>

    <% if @plan.applyable_items.any? %>
      <div class="space-y-4">
        <% if @plan.destructive_items.any? %>
          <label class="flex items-start gap-3 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-950">
            <%= check_box_tag :confirm_destructive, "1", false, class: "mt-1 h-4 w-4 rounded border-red-300 text-red-700 focus:ring-red-600" %>
            <span><strong class="block">Confirm remote search-mode disablement</strong><span class="mt-1 block text-xs leading-5">I reviewed the affected assignments and understand that applying the selected destructive changes will disable remote search modes.</span></span>
          </label>
        <% end %>
        <div class="flex flex-wrap items-center justify-end gap-3">
          <% if revertible_assignment_ids.any? %>
            <%= button_tag "Revert all local changes",
              name: :revert_all,
              value: "1",
              formaction: revert_plan_indexer_apps_path,
              class: "rounded-md border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-stone-50",
              data: { turbo_confirm: "Revert every safely restorable local desired-state change in this preview?" } %>
          <% end %>
          <%= form.submit "Apply selected plan", class: "rounded-md bg-amber-500 px-4 py-2.5 text-sm font-semibold text-stone-950 shadow-sm hover:bg-amber-400" %>
        </div>
      </div>
    <% elsif reviewed_items.any? || unchanged_items.empty? %>
      <p class="text-right text-sm text-slate-600">Nothing to apply.</p>
    <% end %>
  <% end %>
</div>
