<span
  class="inline-flex flex-wrap items-center gap-2"
  data-controller="clipboard"
  data-clipboard-report-value="<%= Base64.strict_encode64(Diagnostics::AssignmentReport.call(indexer_app: assignment)) %>">
  <button
    type="button"
    class="text-xs font-semibold text-slate-600 hover:text-slate-950 disabled:cursor-wait disabled:text-slate-400"
    data-clipboard-target="button"
    data-action="clipboard#copy">
    Copy diagnostic report
  </button>
  <%= link_to "Open diagnostic report",
    diagnostic_indexer_app_path(assignment, format: :text),
    target: "_blank",
    rel: "noopener",
    hidden: true,
    class: "text-xs font-semibold text-blue-700 hover:text-blue-900",
    data: { clipboard_target: "fallback" } %>
  <span class="sr-only" role="status" aria-live="polite" data-clipboard-target="status"></span>
</span>
