<% content_for :title, "Assignment matrix" %>

<%= turbo_stream_from "assignment_matrix" %>

<div class="space-y-6">
  <section class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h1 class="text-3xl font-semibold text-slate-950">Assignment matrix</h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">
        Assign Jackett indexers across apps, manage their settings, and preview remote changes before applying them.
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Preview all", preview_indexer_apps_path, class: "inline-flex items-center justify-center rounded-md border border-stone-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-stone-50" %>
      <%= link_to "Discover indexers", discover_indexers_path, class: "inline-flex items-center justify-center rounded-md bg-amber-500 px-4 py-2.5 text-sm font-semibold text-stone-950 shadow-sm hover:bg-amber-400" %>
    </div>
  </section>

  <%= form_with url: indexer_apps_path, method: :get, class: "flex flex-col gap-3 rounded-md border border-stone-200 bg-white p-4 shadow-sm sm:flex-row sm:items-end" do |form| %>
    <%= form.hidden_field :per_page, value: @indexers_page.per_page %>
    <div class="w-full sm:max-w-xs">
      <%= form.label :filter, "Saved view", class: "block text-sm font-medium text-slate-700" %>
      <%= form.select :filter, matrix_filter_options, { selected: params[:filter] }, class: "mt-2 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm" %>
    </div>
    <%= form.submit "Apply filter", class: "rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-stone-50" %>
    <% if params[:filter].present? %><%= link_to "Clear", indexer_apps_path(per_page: @indexers_page.per_page), class: "px-3 py-2 text-sm font-semibold text-slate-600 hover:text-slate-950" %><% end %>
  <% end %>

  <% if @indexers.any? && @arr_apps.any? %>
    <div class="space-y-4" data-controller="bulk-actions">
      <div class="overflow-x-auto rounded-md border border-stone-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-stone-100 text-left text-xs font-semibold uppercase tracking-normal text-slate-600">
            <tr>
              <th class="sticky left-0 z-10 min-w-52 bg-stone-100 px-4 py-3">Jackett indexer</th>
              <% @arr_apps.each do |arr_app| %>
                <th class="min-w-64 px-4 py-3">
                  <%= link_to arr_app.name, arr_app, class: "hover:underline" %>
                  <span class="mt-1 block font-normal normal-case text-slate-500"><%= arr_app.app_type.titleize %></span>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <% @indexers.each do |indexer| %>
              <tr class="align-top">
                <th class="sticky left-0 z-10 bg-white px-4 py-4 text-left">
                  <%= link_to indexer.name, indexer, class: "font-semibold text-slate-950 hover:underline" %>
                  <span class="mt-1 block font-mono text-xs font-normal text-slate-500"><%= indexer.jackett_id %></span>
                  <% if indexer.jackett_state.in?(%w[renamed changed disabled missing]) %>
                    <span class="mt-2 inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= jackett_state_classes(indexer.jackett_state) %>"><%= indexer.jackett_state.humanize %></span>
                  <% end %>
                </th>
                <% @arr_apps.each do |arr_app| %>
                  <% assignment = @assignments_by_cell[[indexer.id, arr_app.id]] %>
                  <td class="px-4 py-4">
                    <div class="flex items-start gap-3">
                      <%= check_box_tag "cells[]", "#{indexer.id}:#{arr_app.id}", false, form: "assignment-bulk-form", aria: { label: "Select #{indexer.name} for #{arr_app.name}" }, class: "mt-1 h-4 w-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500", data: { bulk_actions_target: "cell", action: "change->bulk-actions#refresh" } %>
                      <div class="min-w-0 flex-1 space-y-2">
                        <% if assignment %>
                          <div class="flex flex-wrap gap-2">
                            <% assignment_search_mode_badges(assignment).each do |label, enabled| %>
                              <span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= enabled_status_classes(enabled) %>"><%= label %></span>
                            <% end %>
                            <span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= assignment_connection_mode_classes(assignment) %>"><%= assignment.connection_mode.titleize %></span>
                            <span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= reconciliation_state_classes(assignment.last_plan_state) %>"><%= reconciliation_state_label(assignment.last_plan_state) %></span>
                          </div>
                          <p class="text-xs leading-5 text-slate-600"><%= assignment_status_label(assignment) %><% if assignment.last_synced_at %> · <%= format_server_timestamp(assignment.last_synced_at) %><% end %></p>
                          <% if assignment.last_error.present? %>
                            <p class="text-xs leading-5 <%= assignment_error_classes(assignment) %>"><%= assignment_error_summary(assignment) %></p>
                            <p class="text-xs leading-5 text-slate-600"><%= assignment_error_recommendation(assignment) %></p>
                            <%= render "indexer_apps/diagnostic_button", assignment: %>
                          <% end %>
                          <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-semibold">
                            <%= link_to "Settings", edit_indexer_app_path(assignment, return_to: "matrix"), class: "text-slate-700 hover:text-slate-950" %>
                            <%= link_to "Preview", preview_indexer_apps_path(assignment_ids: [ assignment.id ]), class: "text-blue-700 hover:text-blue-900" %>
                            <%= button_to "Remove",
                              indexer_app_path(assignment),
                              method: :delete,
                              class: "cursor-pointer text-red-700 hover:text-red-900",
                              form: { class: "inline", data: { turbo_confirm: "Remove this assignment and its managed remote indexer?" } } %>
                          </div>
                        <% else %>
                          <span class="inline-flex rounded-md border border-dashed border-slate-300 bg-white px-2 py-1 text-xs font-semibold text-slate-500">Unassigned</span>
                          <p class="text-xs leading-5 text-slate-500">Select this cell and choose Create assignment.</p>
                        <% end %>
                      </div>
                    </div>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= form_with url: bulk_update_indexer_apps_path, id: "assignment-bulk-form", class: "space-y-4" do |form| %>
        <%= hidden_field_tag :filter, params[:filter] %>
        <%= hidden_field_tag :page, @indexers_page.current_page %>
        <%= hidden_field_tag :per_page, @indexers_page.per_page %>

      <div class="rounded-md border border-stone-200 bg-white p-5 shadow-sm">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div class="w-full sm:max-w-sm">
            <%= label_tag :bulk_action, "Bulk action", class: "block text-sm font-medium text-slate-700" %>
            <%= select_tag :bulk_action, options_for_select([
              ["Choose an action…", ""],
              ["Create assignment", "create"], ["Update search modes", "search_modes"],
              ["Use direct mode", "direct"], ["Use bridged mode", "bridged"], ["Update categories", "categories"],
              ["Preview / test", "preview"], ["Preview selected sync", "sync"]
            ]), class: "mt-2 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm", data: { bulk_actions_target: "action", action: "change->bulk-actions#refresh" } %>
          </div>
          <p class="text-sm font-semibold text-slate-700" data-bulk-actions-target="selectedCount" aria-live="polite">0 cells selected</p>
        </div>

        <div class="mt-5 rounded-md border border-stone-200 bg-stone-50 p-4" data-bulk-actions-target="panel" data-bulk-action="create" hidden>
          <h2 class="text-sm font-semibold text-slate-900">Create assignments</h2>
          <p class="mt-1 text-xs leading-5 text-slate-600">Creates missing assignments with all three search modes enabled. Cells that already have assignments are skipped.</p>
        </div>

        <div class="mt-5 rounded-md border border-stone-200 bg-stone-50 p-4" data-bulk-actions-target="panel" data-bulk-action="search_modes" hidden>
          <h2 class="text-sm font-semibold text-slate-900">Search modes</h2>
          <p class="mt-1 text-xs leading-5 text-slate-600">Keep existing leaves that setting unchanged. Unassigned cells are skipped, and selected assignments continue directly to reconciliation preview.</p>
          <div class="mt-3 grid gap-3 md:grid-cols-3">
            <% [
              [ :enable_rss, "RSS" ],
              [ :enable_automatic_search, "Automatic search" ],
              [ :enable_interactive_search, "Interactive search" ]
            ].each do |field, label| %>
              <div>
                <%= label_tag field, label, class: "block text-sm font-medium text-slate-700" %>
                <%= select_tag field, options_for_select([["Keep existing", "keep"], ["Enable", "enable"], ["Disable", "disable"]]), class: "mt-2 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm" %>
              </div>
            <% end %>
          </div>
        </div>

        <% {
          "direct" => ["Use direct mode", "Points selected assignments directly at Jackett, then opens reconciliation preview."],
          "bridged" => ["Use bridged mode", "Points selected assignments through Bridgarr, then opens reconciliation preview."],
          "preview" => ["Preview selected assignments", "Inspects the selected assignments without changing local or remote settings."],
          "sync" => ["Review selected sync", "Opens reconciliation preview so remote changes can be reviewed before they are queued."]
        }.each do |action, (heading, description)| %>
          <div class="mt-5 rounded-md border border-stone-200 bg-stone-50 p-4" data-bulk-actions-target="panel" data-bulk-action="<%= action %>" hidden>
            <h2 class="text-sm font-semibold text-slate-900"><%= heading %></h2>
            <p class="mt-1 text-xs leading-5 text-slate-600"><%= description %></p>
          </div>
        <% end %>

        <div class="mt-5 rounded-md border border-stone-200 bg-stone-50 p-4" data-bulk-actions-target="panel" data-bulk-action="categories" hidden>
          <div>
            <h2 class="text-sm font-semibold text-slate-900">Categories</h2>
            <p class="mt-1 text-xs leading-5 text-slate-600">Updates the desired category policy, then opens reconciliation preview.</p>
          </div>
          <div class="mt-3 grid gap-3 md:grid-cols-2">
            <div>
              <%= label_tag :category_mode, "Category mode", class: "block text-sm font-medium text-slate-700" %>
              <%= select_tag :category_mode, options_for_select([["Auto", "auto"], ["Custom", "custom"], ["None", "none"]]), class: "mt-2 block w-full rounded-md border border-stone-300 bg-white px-3 py-2 text-sm" %>
            </div>
            <div>
              <%= label_tag :custom_categories, "Custom category IDs", class: "block text-sm font-medium text-slate-700" %>
              <%= text_field_tag :custom_categories, nil, placeholder: "Enter comma-separated IDs", class: "mt-2 block w-full rounded-md border border-stone-300 px-3 py-2 font-mono text-sm" %>
            </div>
          </div>
        </div>

        <div class="mt-5 flex justify-end">
          <%= form.button "Choose a bulk action", type: :submit, disabled: true, class: "w-full rounded-md bg-amber-500 px-4 py-2.5 text-sm font-semibold text-stone-950 shadow-sm hover:bg-amber-400 disabled:cursor-not-allowed disabled:bg-stone-200 disabled:text-slate-500 sm:w-auto", data: { bulk_actions_target: "submit" } %>
        </div>
      </div>
    <% end %>
    </div>
    <%= render "shared/pagination",
      pagination: @indexers_page,
      item_name: "indexer",
      path: indexer_apps_path,
      preserved_params: { filter: params[:filter] } %>
  <% else %>
    <div class="rounded-md border border-stone-200 bg-white px-6 py-12 text-center shadow-sm">
      <p class="text-sm font-medium text-slate-700">The matrix needs at least one indexer and one Arr application.</p>
    </div>
  <% end %>
</div>
