<table class="min-w-full divide-y divide-slate-200 text-sm" data-reconciliation-items="<%= table_kind %>">
  <thead class="bg-stone-100 text-left text-xs font-semibold uppercase tracking-normal text-slate-600">
    <tr>
      <th class="px-4 py-3">Apply</th>
      <th class="px-4 py-3">Assignment</th>
      <th class="px-4 py-3">Plan</th>
      <th class="px-4 py-3">Changes and next action</th>
    </tr>
  </thead>
  <tbody class="divide-y divide-slate-200">
    <% items.each do |item| %>
      <% assignment = item.indexer_app %>
      <% revert_options = revert_options_by_assignment_id.fetch(assignment.id) %>
      <tr class="align-top">
        <td class="px-4 py-4">
          <% if item.applyable? %>
            <%= check_box_tag "assignment_ids[]", assignment.id, true, class: "h-4 w-4 rounded border-stone-300 text-amber-600 focus:ring-amber-500" %>
            <%= hidden_field_tag "expected_digests[#{assignment.id}]", item.plan_digest %>
          <% else %>
            <span class="text-slate-400" aria-label="No apply action">—</span>
          <% end %>
        </td>
        <td class="px-4 py-4">
          <p class="font-medium text-slate-950"><%= assignment.indexer.name %></p>
          <p class="mt-1 text-xs text-slate-500"><%= assignment.arr_app.name %> · <%= assignment.connection_mode.titleize %></p>
          <p class="mt-1 text-xs text-slate-500"><%= assignment_search_mode_badges(assignment).map(&:first).join(" · ") %></p>
        </td>
        <td class="px-4 py-4"><span class="inline-flex rounded-md border px-2 py-1 text-xs font-semibold <%= reconciliation_state_classes(item.state) %>"><%= reconciliation_state_label(item.state) %></span></td>
        <td class="px-4 py-4">
          <p class="text-sm leading-6 text-slate-700"><%= item.message %></p>
          <% if item.destructive %>
            <p class="mt-2 text-xs font-semibold text-red-800">One or more remote search modes will be disabled.</p>
          <% end %>
          <% if item.changes.any? %>
            <% rendered_revert_option_keys = [] %>
            <ul class="mt-2 space-y-1 text-xs leading-5 text-slate-600">
              <% item.changes.each do |change| %>
                <% revert_option = revert_options.find { |option| option.remote_fields.include?(change["field"]) && !rendered_revert_option_keys.include?(option.key) } %>
                <li class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span><span class="font-semibold text-slate-800"><%= change["label"] %>:</span> <%= change["current"] %> → <%= change["desired"] %></span>
                  <% if revert_option %>
                    <%= button_tag "Revert #{revert_option.label}",
                      name: :revert_target,
                      value: "#{assignment.id}:#{revert_option.key}",
                      formaction: revert_plan_indexer_apps_path,
                      class: "font-semibold text-blue-700 hover:text-blue-900",
                      data: { turbo_confirm: "Revert #{revert_option.label} to its last successfully applied value? This changes only Bridgarr's desired state." } %>
                    <% rendered_revert_option_keys << revert_option.key %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <div class="mt-3 flex flex-wrap gap-3 text-xs font-semibold">
            <%= link_to "Assignment settings", edit_indexer_app_path(assignment, return_to: "preview"), class: "text-slate-700 hover:text-slate-950" %>
            <% if revert_options.many? %>
              <%= button_tag "Revert all for this assignment",
                name: :revert_target,
                value: "#{assignment.id}:all",
                formaction: revert_plan_indexer_apps_path,
                class: "text-blue-700 hover:text-blue-900",
                data: { turbo_confirm: "Revert all local desired-state changes for #{assignment.indexer.name} in #{assignment.arr_app.name}?" } %>
            <% end %>
            <% if item.state == "conflict" && item.remote_indexer_id.present? %>
              <% repair_confirmation = if assignment.all_search_modes_enabled?; "Associate this assignment with remote indexer ID #{item.remote_indexer_id} and sync it?"; else; "Associate this assignment with remote indexer ID #{item.remote_indexer_id}? You will return to preview before any remote change."; end %>
              <%= link_to "Repair association", repair_indexer_app_path(assignment, remote_indexer_id: item.remote_indexer_id), class: "text-blue-700 hover:text-blue-900", data: { turbo_method: :post, turbo_confirm: repair_confirmation } %>
            <% elsif item.state == "orphaned" %>
              <%= link_to "Forget stale association", forget_remote_indexer_app_path(assignment), class: "text-blue-700 hover:text-blue-900", data: { turbo_method: :post, turbo_confirm: "Forget remote indexer ID #{assignment.remote_indexer_id}? This does not delete anything remotely." } %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
